#!/bin/sh

set -eu

project_directory=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
cd "$project_directory"

if command -v uv >/dev/null 2>&1; then
    exec uv run puddle-jump "$@"
fi

if [ -x ".venv/bin/python" ]; then
    exec .venv/bin/python -m puddle_jump.main "$@"
fi

echo "Run 'uv sync' before starting Puddle Jump."
exit 1
